  // Get products
  const getProducts = async () => {
    let url = ${API}/products?;

    if (search) {
      url += search=${search}&;
    }

    if (category !== "All") {
      url += category=${category}&;
    }

    const response = await fetch(url);

    const data = await response.json();

    setProducts(data);
