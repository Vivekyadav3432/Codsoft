function SearchBox() {

  const [search, setSearch] =
    useState("");

  const navigate =
    useNavigate();


  function submit(e) {

    e.preventDefault();

    navigate(
      `/jobs?search=${encodeURIComponent(
        search
      )}`
    );
  }


  return (
    <form
      className="search-box"
      onSubmit={submit}
    >

      <input
        value={search}
        onChange={e =>
          setSearch(e.target.value)
        }
        placeholder="Job title, company..."
      />

      <button className="btn">
        🔍 Search
      </button>

    </form>
  );
}


